+
     if (GameStatus(msBoard(), ms.bgv) || ms.gs == GAME_DROP || ms.gs == GAME_RESIGNED) {
         moverecord *pmr = (moverecord *) plGame->plNext->p;
         xmovegameinfo *pmgi = &pmr->g;
