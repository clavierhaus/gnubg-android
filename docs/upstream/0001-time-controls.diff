+extern void
+CommandSetClockOn(char *UNUSED(sz))
+{
+    fClockEnabled = TRUE;
+    if (tcMatch.fActive)
+        tc_resume(&tcMatch, (uint64_t) get_time());
+    outputf(_("The match clock is on (%d second delay, %d minute(s) reserve "
+              "per point).\n"), nClockDelay, nClockReserve);
+}
+
+extern void
+CommandSetClockOff(char *UNUSED(sz))
+{
+    fClockEnabled = FALSE;
+    if (tcMatch.fActive)
+        tc_pause(&tcMatch, (uint64_t) get_time());
+    outputl(_("The match clock is off."));
+}
+
+extern void
+CommandSetClockDelay(char *sz)
+{
+    int n;
+
+    if ((n = ParseNumber(&sz)) < 0 || n > 60) {
+        outputl(_("You must specify a delay between 0 and 60 seconds "
+                  "(see `help set clock delay')."));
+        return;
+    }
+    nClockDelay = n;
+    if (tcMatch.fActive)
+        tcMatch.msDelay = (uint64_t) n * 1000;
+    outputf(_("The clock delay is %d second(s) per move.\n"), n);
+}
+
+extern void
+CommandSetClockReserve(char *sz)
+{
+    int n;
+
+    if ((n = ParseNumber(&sz)) < 1 || n > 60) {
+        outputl(_("You must specify a reserve between 1 and 60 minutes per "
+                  "point (see `help set clock reserve')."));
+        return;
+    }
+    nClockReserve = n;
+    outputf(_("The clock reserve is %d minute(s) per point of match length, "
+              "taking effect when the next match starts.\n"), n);
+}
+
