+/*
+ * Tournament match clock (timecontrol.c).  The clock is charged at
+ * action boundaries using gnubg's monotonic millisecond timer -- no
+ * ticker anywhere, exactly as a physical clock runs while you think
+ * and settles when you act.  The per-move delay is granted on each
+ * change of the side to move: one press per turn.  A fallen flag is
+ * reported, never enforced -- under tournament rules, claiming the
+ * match is the operator's act, not the clock's.
+ */
+
+static int nClockLastSide = -1;
+
+static void
+ClockReportEvent(tcevent ev)
+{
+    if (ev == TC_EVENT_NONE)
+        return;
+    outputf(_("%s has run out of reserve time.\n"),
+            ap[ev == TC_EVENT_FLAG_PLAYER0 ? 0 : 1].szName);
+    outputl(_("Under tournament rules the match may now be claimed; "
+              "play continues."));
+}
+
+static void
+ClockHandOver(void)
+{
+    int nSide;
+
+    if (!fClockEnabled || !tcMatch.fActive)
+        return;
+    nSide = (ms.gs == GAME_PLAYING) ? ms.fTurn : -1;
+    if (nSide == nClockLastSide)
+        ClockReportEvent(tc_settle(&tcMatch, (uint64_t) get_time()));
+    else {
+        ClockReportEvent(tc_start_turn(&tcMatch, nSide, (uint64_t) get_time()));
+        nClockLastSide = nSide;
+    }
+}
+
 static int
 NewGame(void)
 {
@@ -923,6 +962,19 @@ NewGame(void)
 
     UpdateSetting(&ms.fTurn);
     UpdateSetting(&ms.gs);
+
+    if (fClockEnabled) {
+        if (!ms.anScore[0] && !ms.anScore[1]) {
+            /* first game: arm the match clock */
+            uint64_t msReserve = (uint64_t) nClockReserve * 60000 *
+                (ms.nMatchTo ? ms.nMatchTo : 1);
+
+            tc_init(&tcMatch, (uint64_t) nClockDelay * 1000, msReserve, msReserve);
+            nClockLastSide = -1;
+        }
+        ClockHandOver();
+    }
+
     /* Play sound after initial dice decided */
     DiceRolled();
 #if defined (USE_GTK)
@@ -1772,6 +1824,8 @@ NextTurn(int fPlayNext)
