+static void
+FormatClockInterval(char *sz, uint64_t ms)
+{
+    unsigned int s = (unsigned int) (ms / 1000);
+
+    if (s >= 3600)
+        sprintf(sz, "%u:%02u:%02u", s / 3600, (s / 60) % 60, s % 60);
+    else
+        sprintf(sz, "%u:%02u", s / 60, s % 60);
+}
+
+extern void
+CommandShowClock(char *UNUSED(sz))
+{
+    tcstate tcs;
+    char szTime[32];
+    int i;
+
+    outputf(_("Match clock: %s (%d second delay, %d minute(s) reserve per "
+              "point).\n"), fClockEnabled ? _("on") : _("off"),
+            nClockDelay, nClockReserve);
+
+    if (!tcMatch.fActive) {
+        outputl(_("No clocked match is in progress."));
+        return;
+    }
+
+    tc_state(&tcMatch, &tcs);
+    for (i = 0; i < 2; ++i) {
+        FormatClockInterval(szTime, tcs.amsReserve[i]);
+        outputf("%-31s %s%s%s\n", ap[i].szName, szTime,
+                tcs.nActiveSide == i ? _(" (to move)") : "",
+                tcs.afFlagged[i] ? _(" [flag fallen]") : "");
+    }
+    if (tcs.nActiveSide >= 0 && tcs.msDelayLeft) {
+        FormatClockInterval(szTime, tcs.msDelayLeft);
+        outputf(_("Delay remaining this move: %s\n"), szTime);
+    }
+    if (tcs.fPaused)
+        outputl(_("The clock is paused."));
+}
+
 extern void
 CommandShowClockwise(char *UNUSED(sz))
 {
